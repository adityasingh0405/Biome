# ============================================================
# Biome RAG — Frontend Environment Configuration
# Copy this file to frontend/.env and fill in your values.
# NEVER commit frontend/.env to version control.
# ============================================================

# API base URL.
# Leave empty to use the Vite dev-server proxy (/v1 → http://127.0.0.1:8000).
# Set to the full backend URL for production or Docker Compose deployments.
# Example: VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

