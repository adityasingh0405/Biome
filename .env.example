# ============================================================
# Biome RAG — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- General -----------------------------------------------
LOG_LEVEL=INFO

# ---- LLM Provider ------------------------------------------
# Options: local | ollama | openai | anthropic | groq
LLM_PROVIDER=ollama

# ---- Ollama (local inference, Phase 0+) --------------------
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60

# ---- OpenAI (cloud fallback) --------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic / Claude -------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Groq (Phase 5 LLM fallback) ---------------------------
# Get key at: https://console.groq.com/
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# ---- Embeddings (Phase 3+) ----------------------------------
# Options: sentence-transformers | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_COLLECTION_NAME=enterprise_kb
EMBEDDING_DEVICE=cpu

# ---- Qdrant (Phase 3+ — run via docker-compose) ------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_kb
# Leave blank for local unauthenticated Qdrant
QDRANT_API_KEY=

# ---- PostgreSQL (Phase 1+) ----------------------------------
# Format: postgresql://user:password@host:port/dbname
# NEVER put real passwords in this file — only in .env
POSTGRES_URI=postgresql://postgres:yourpassword@localhost:5432/enterprise_rag
POSTGRES_TABLE=enterprise_tickets

# ---- Redis (Phase 5 — session memory) ----------------------
# Run via docker-compose
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=3600
REDIS_WINDOW_SIZE=10

# ---- Slack Ingestion (Phase 1) ------------------------------
# Create a Slack app at https://api.slack.com/apps
# Required scopes: channels:history, channels:read, groups:history,
#                  im:history, mpim:history, users:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_WORKSPACE_ID=T0XXXXXXX

# ---- Langfuse Observability (Phase 5+) ----------------------
# Run via docker-compose or sign up at https://langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false
# Langfuse's own Postgres (internal — only needed for docker-compose)
LANGFUSE_DB_PASSWORD=langfuse_db_password

# ---- Chunking (Phase 2+) ------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEDUP_THRESHOLD=0.95
PDF_CHUNK_MAX_TOKENS=600
PDF_CHUNK_MIN_TOKENS=400
SLACK_CHUNK_MAX_TOKENS=400
SLACK_CHUNK_MIN_TOKENS=256
PG_CHUNK_MAX_TOKENS=256
PG_CHUNK_MIN_TOKENS=128
TABLE_SPLIT_MAX_TOKENS=600

# ---- Retrieval ---------------------------------------------
DENSE_TOP_K=5
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3
RRF_K=60
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_TOKENS=1500
FALLBACK_KEYWORD_THRESHOLD=0.5

# ---- Citation & Confidence ---------------------------------
CITATION_VERIFICATION_ENABLED=true
INSUFFICIENT_CONFIDENCE_THRESHOLD=0.5
# Comma-separated list of field names treated as sensitive
SENSITIVE_FIELDS=salary,ssn,tax_id,password,secret

# ---- Misc --------------------------------------------------
RETRY_ATTEMPTS=2
