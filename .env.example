# ============================================================
# Biome RAG — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Authentication ---
BIOME_API_KEY=your-biome-api-key-here
BIOME_DEPLOY_TARGET=dev

# --- LLM Provider ---
# Options: local | ollama | openai | anthropic
LLM_PROVIDER=local

# --- Ollama (for local inference) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60

# --- OpenAI (for cloud inference) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Embeddings ---
# Options: sentence-transformers | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_COLLECTION_NAME=biome-chunks

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DEDUP_THRESHOLD=0.95

# --- Retrieval ---
DENSE_TOP_K=5
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_TOKENS=1500
FALLBACK_KEYWORD_THRESHOLD=0.5

# --- Citation & Confidence ---
CITATION_VERIFICATION_ENABLED=true
INSUFFICIENT_CONFIDENCE_THRESHOLD=0.5
RETRY_ATTEMPTS=2

# --- Logging ---
LOG_LEVEL=INFO
